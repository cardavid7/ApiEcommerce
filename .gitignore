# ---- Backend (.NET) ----
# Build results
backend/[Bb]in/
backend/[Oo]bj/
[Bb]in/
[Oo]bj/
[Oo]ut/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / VS Code
.vs/
.vscode/

# ASP.NET Core
backend/appsettings.Development.json
backend/appsettings.Local.json
backend/secrets.json

# Uploaded product images (user content, no debe versionarse) -
# excepto seed/, que son las fotos iniciales committeadas con el repo.
backend/wwwroot/ProductsImages/*
!backend/wwwroot/ProductsImages/seed/
!backend/wwwroot/ProductsImages/seed/**

# Entity Framework / migrations local artifacts
backend/Migrations/*.cs.sql

# ---- Frontend (Angular) ----
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/npm-debug.log*

# ---- Common ----
# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# NuGet packages
*.nupkg
*.snupkg
packages/

# Test results
TestResults/

# Rider / JetBrains
.idea/
*.iml
